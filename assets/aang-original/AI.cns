[State -2, Defensa (Agachado a De Pie)]
type = ChangeState
triggerall = Var(59) = 1
triggerall = Statetype != A
triggerall = P2statetype != C
triggerall = P2Movetype = A
trigger1 = 1
trigger1 = StateNo = 152
value = 150



[State -2, Air Recover]
type = ChangeState
value = 5210
triggerall = Var(10) = 1
triggerall = StateType = A
triggerall = StateType != L
triggerall = Pos Y < -20
triggerall = Alive = 1
trigger1 = CanRecover = 1
trigger1 = StateNo = 5050
trigger1 = Var(4) = [750,900]

[State -3, Aire control]
type = ChangeState
triggerall = p2life != 0
