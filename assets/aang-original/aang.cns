;===============================================================================
; Super Jump:
;-------------------------------------------------------------------------------
[Statedef 80]
type    = A
movetype= I
physics = N
juggle  = 0
velset = 0,-9
anim = 43
sprpriority = 2
ctrl = 0

[state 180 1]
Type = playsnd
Trigger1 = AnimElem = 1
Value = S60,1

[state 900 5]
Type = explod
Trigger1 = time = 0
Anim = 7110
Pos = 0, 10
Postype = p1
scale = .5, .5
sprpriority = 5
Removetime = -2
ownpal = 1
removeongethit = 1

[State 40]
type = RemoveExplod
trigger1 = time = 0
ID = 52

[State 0, CtrlSet]
type = CtrlSet
trigger1 = time >= 1
value = 1

[State 0, VelSet]
type = VelSet
trigger1 = command = "holdfwd"
x = 4

[State 0, VelSet]
type = VelSet
trigger1 = command = "holdback"
x = -4

[State 0, Veladd]
type = Veladd
trigger1 = time > 10
y = .4
x = 0

[State 200, End]
type = ChangeState
triggerall = time > 0
trigger1 = pos y >= -1
value = 52
